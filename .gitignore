# macOS noise
.DS_Store

# Local Claude Code config — selective.
# Track project-portable pieces (settings.json, hooks/, auto-sync.sh) so they
# ride with the repo. Ignore machine-specific symlinks under .claude/skills/
# (they point to absolute paths that don't survive a machine move) and any
# per-machine settings overrides.
.claude/skills/
.claude/settings.local.json

# Python's compiled copies of scripts (rebuilt automatically, machine-specific)
__pycache__/
*.pyc

# Microsoft Office lock/temp files (created while a doc is open)
~$*
*.tmp

# LibreOffice / OpenOffice lock files
.~lock.*

# Playwright session cache (browser profile, downloads, traces — local-only,
# regenerable, large)
.playwright-mcp/

# QA evidence screenshots — pointers to Certify, not deliverables. Regenerable
# from a re-run. Keep them local to avoid bloating the repo.
outputs/**/screenshots/

# Loose binary captures or scrapes that somehow land at the workspace root
# (the workspace_hygiene_guard hook should prevent this, but belt-and-suspenders
# in case the hook is ever disabled). Subfolders are NOT affected.
/*.png
/*.jpg
/*.jpeg
/*.yml
/*.yaml
