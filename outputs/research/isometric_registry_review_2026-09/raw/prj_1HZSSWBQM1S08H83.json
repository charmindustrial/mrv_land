30.658\",\"582.332\"],[\"18 Mar 2026\",\"764.14\",\"38.216\",\"725.924\"],[\"24 Feb 2026\",\"43.47\",\"2.174\",\"41.296\"],[\"05 Dec 2025\",\"454.71\",\"22.739\",\"431.971\"],[\"02 Nov 2025\",\"291.85\",\"14.594\",\"277.256\"],[\"09 Oct 2025\",\"166.4\",\"8.324\",\"158.076\"]]}],\"links\":[{\"h\":\"/supplier/spl_1H31MW3T81S0R67B\",\"t\":\"Charm Industrial\"},{\"h\":\"https://350solutions.com\",\"t\":\"350Solutions\"},{\"h\":\"/protocol/bio-oil-geological-storage/1.2\",\"t\":\"Bio-oil Geological Storage v1.2\"},{\"h\":\"/protocol/bio-oil-geological-storage/1.0\",\"t\":\"Bio-oil Geological Storage v1.0\"},{\"h\":\"https://storage.googleapis.com/isometric--production--eu--public-documents/spl_1H31MW3T81S0R67B/prj_1HZSSWBQM1S08H83/pjd_1KAERQ5A11S081G0/pdd.pdf\",\"t\":\"Project Design Document | 20 Feb 2025\"},{\"h\":\"/ghg-entry/rmv_1KZBJBN9C1S0M5R5?tab=calculation-view\",\"t\":\"See GHG entry →\"},{\"h\":\"https://storage.googleapis.com/isometric--production--eu--public-documents/spl_1H31MW3T81S0R67B/prj_1HZSSWBQM1S08H83/pjd_1M02YD83Z1S0J5PN/verification_report.pdf\",\"t\":\"PDF | ->\"},{\"h\":\"https://storage.googleapis.com/isometric--production--eu--public-documents/spl_1H31MW3T81S0R67B/prj_1HZSSWBQM1S08H83/pjd_1M02YCEEP1S0AVZB/ghg_statement_report.pdf\",\"t\":\"PDF | ->\"},{\"h\":\"https://storage.googleapis.com/isometric--production--eu--public-documents/spl_1H31MW3T81S0R67B/prj_1HZSSWBQM1S08H83/pjd_1KXRNS8G91S0SSQB/verification_report.pdf\",\"t\":\"PDF | ->\"},{\"h\":\"https://storage.googleapis.com/isometric--production--eu--public-documents/spl_1H31MW3T81S0R67B/prj_1HZSSWBQM1S08H83/pjd_1KXRNRYWZ1S0JG01/ghg_statement_report.pdf\",\"t\":\"PDF | ->\"},{\"h\":\"https://storage.googleapis.com/isometric--production--eu--public-documents/spl_1H31MW3T81S0R67B/prj_1HZSSWBQM1S08H83/pjd_1KVQC8PD81S08MGG/verification_report.pdf\",\"t\":\"PDF | ->\"}],\"text\":\"VALIDATED\\nBICRS\\n1,000Y+\\nCharm Bio-oil Geologic Storage\\nCharm Industrial\\nISSUED\\n8,426.77\\nBUFFER POOL\\n315.808\\nCREDITING PERIOD\\n01 Mar 2024 to 28 Feb 2029\\nSummary\\nRemoval method\\nCalculation overview\\nFeedstocks\\nProject documentation\\nCertificates\\nReversal risk\\nSummary\\n\\nCharm produces bio-oil, a carbon rich liquid made from unmerchantable wildfire prevention residues in Colorado and procures bio-oil produced by third parties, made from forest products processing residuals. A combination of rail and truck is used to transport bio-oil to injection well sites that are converted oil assets. Permanent sequestration will occur in multiple locations, such as Kansas and Louisiana.\\n\\nPROJECT DETAILS\\nCurrent verifier\\n350Solutions\\n->\\nProject code\\n7BDE\\nApproval date\\n20 Aug 2024\\nCurrent protocol version\\nBio-oil Geological Storage v1.2\\nBaseline protocol version\\nBio-oil Geological Storage v1.0\\nSUSTAINABLE DEVELOPMENT GOALS\\n⌘ + scroll to zoom\\nCharm Bio-oil Geologic Storage\\nHow carbon is being removed\\n\\nBiomass Carbon Removal and Storage (BiCRS) involves storing the carbon contained in waste biomass—organic material from living or recently living organisms. BiCRS works by halting or slowing the decomposition of biomass, enabling the carbon it contains to be stored long-term. This can be achieved by converting biomass into materials that decompose more slowly—such as biochar or bio-oil—or by storing it in environments where decomposition is slowed. For BiCRS to count as carbon removal, the biomass must be replenished to ensure additional carbon dioxide is drawn from the atmosphere.\\n\\nProject Design Document\\n20 Feb 2025\\nCalculation overview\\nCalculations demonstrating 159.49 tCO₂e removed from Charm Bio-oil Geologic Storage on 25 Jul 2026\\nSee GHG entry →\\nNet CO₂e Removed\\n159.491 t\\nSequestrations\\n193.725 t\\n+\\nAdjustments\\n20.929 tCO₂e\\n-\\nActivities\\n54.091 tCO₂e\\n-\\nUncertainty Discount\\n1.072 t\\n⌘ + scroll to zoom\\nView full screen\\nFeedstocks\\n\\nFeedstocks are the validated input materials that have been used for this project.\\n\\nName\\tCategory\\tValidated\\nKerry Inc 1-01\\tBiomass\\t12 Feb 2026\\nShowing 1 of 1\\nPrevious\\nNext\\nProject documentation\\nSubmission date\\tTitle\\tDownload\\n15 Aug 2026\\tVerification Report\\tPDF\\n->\\n\\n15 Aug 2026\\tGHG Statement Report\\tPDF\\n->\\n\\n17 Jul 2026\\tVerification Report\\tPDF\\n->\\n\\n17 Jul 2026\\tGHG Statement Report\\tPDF\\n->\\n\\n22 Jun 2026\\tVerification Report\\tPDF\\n->\\nShowing 5 of 40\\nPrevious\\nNext\\nCertificates\\nIssued\\n8,426.77\\nRetired\\n5,105.13\\nBuffer pool\\n315.808\\nCrediting period\\n01 Mar 2024 to 28 Feb 2029\\nIssuances\\nRetirements\\nIssue date\\tIssued\\tBuffer pool\\tSupplier allocation\\n15 Aug 2026\\t874.29\\t43.716\\t830.574\\n17 Jul 2026\\t647.05\\t32.353\\t614.697\\n22 Jun 2026\\t425.59\\t21.281\\t404.309\\n27 May 2026\\t490.82\\t24.547\\t466.273\\n17 Apr 2026\\t612.99\\t30.658\\t582.332\\n18 Mar 2026\\t764.14\\t38.216\\t725.924\\n24 Feb 2026\\t43.47\\t2.174\\t41.296\\n05 Dec 2025\\t454.71\\t22.739\\t431.971\\n02 Nov 2025\\t291.85\\t14.594\\t277.256\\n09 Oct 2025\\t166.4\\t8.324\\t158.076\\nShowing 10 of 18\\nPrevious\\nNext\\nReversal risk\\n\\nThe risk of reversal for this project has been assessed as low. This means that 5% of certificates issued for this project are allocated to Charm Industrial's buffer pool.\\n\\nTo date, this project has contributed 315.808 certificates to the buffer pool which holds a total of 317.85 certificates.\\n\\nCharm Industrial has no reversals to date.\\n\\nLearn more about reversal risk\"}"